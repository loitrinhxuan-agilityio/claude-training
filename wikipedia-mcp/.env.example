# Optional: anthropic | openai
# If unset, the provider is picked from whichever API key is set (Anthropic wins if both are).
LLM_PROVIDER=

ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-5

# To use OpenAI instead, set LLM_PROVIDER=openai (or just remove the Anthropic key) and fill in:
# OPENAI_API_KEY=replace-with-your-openai-api-key
# OPENAI_MODEL=gpt-4.1-mini

# Optional: directories to share with the server via MCP Roots (separated by ':' on macOS/Linux, ';' on Windows).
# Used only when no --root flag is passed to client.py.
# MCP_ROOTS=./sample-docs
